{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display, user_avatar %}

<div class="col-md-8 mx-auto mb-4">
  <a href="{{ url_for('feed') }}" class="text-decoration-none small">&larr; Back to main feed</a>
  <div class="card border-0 shadow-sm text-white mt-3" style="background: linear-gradient(120deg, #0d6efd, #084298);">
    <div class="card-body py-4">
      <div class="small text-white-50 text-uppercase fw-semibold mb-1">Town Hall</div>
      <h1 class="h3 text-white mb-2">{{ country_flag(country.country_code) }} {{ country.country_name }} Town Hall</h1>
      <p class="mb-0 text-white">A place to discuss topics with people from {{ country.country_name }}.</p>
    </div>
  </div>
</div>

<div class="col-md-8 mx-auto mb-4">
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="h5 card-title">Post to your Town Hall</h2>
      <form action="{{ url_for('add_post') }}" method="POST">
        <input type="hidden" name="town_hall_country_code" value="{{ country.country_code }}">
        <div class="mb-3">
          <textarea class="form-control" name="content" rows="3"
                    placeholder="What's on your mind, {{ session.get('username') }}?" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary float-end">Post to Town Hall</button>
        <div class="clearfix"></div>
      </form>
    </div>
  </div>
</div>

<div class="col-md-8 mx-auto">
  <h2 class="h4 border-bottom pb-2 mb-4">Posts from {{ country.country_name }}</h2>

  {% for entry in posts %}
  <div class="card mb-4" id="post-{{ entry.post.id }}">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <div class="d-flex align-items-center gap-2">
          {{ user_avatar(entry.post.username, entry.post.profile_picture, size='md') }}
          <div>
            <h3 class="card-title mb-0 fs-5">{{ user_display(entry.post.username, entry.post.profile_picture) }}</h3>
            <small class="text-muted">{{ entry.post.created_at|datetimeformat }}</small>
          </div>
        </div>
        {% if session.get('user_id') == entry.post.user_id or session.get('username') == 'admin' %}
        <form action="{{ url_for('delete_post', post_id=entry.post.id) }}" method="POST"
              onsubmit="return confirm('Are you sure you want to delete this post?');">
          <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete post">Delete</button>
        </form>
        {% endif %}
      </div>

      <p class="mt-3 mb-3" style="white-space: pre-wrap;">{{ entry.post.content }}</p>

      <div class="d-flex align-items-center flex-wrap gap-2 mt-2 mb-3">
        <div class="d-flex align-items-center gap-2">
          {% if entry.reactions %}
            {% for react in entry.reactions %}
              {% if react.reaction_type == entry.user_reaction %}
                <form action="{{ url_for('unreact') }}" method="post" class="d-inline">
                  <input type="hidden" name="post_id" value="{{ entry.post.id }}">
                  <button type="submit" class="btn btn-sm btn-light" title="Remove your {{ react.reaction_type }} reaction">
                    {{ reaction_emojis.get(react.reaction_type, '👍') }} {{ react.count }}
                  </button>
                </form>
              {% else %}
                <span class="small" title="{{ react.reaction_type|capitalize }}">{{ reaction_emojis.get(react.reaction_type, '👍') }} {{ react.count }}</span>
              {% endif %}
            {% endfor %}
          {% else %}
            <span class="small text-muted">No reactions yet</span>
          {% endif %}
        </div>
        <div class="dropdown">
          <button class="btn btn-sm btn-outline-secondary" type="button" id="townhall-reaction-{{ entry.post.id }}"
                  data-bs-toggle="dropdown" aria-expanded="false">React +</button>
          <ul class="dropdown-menu" aria-labelledby="townhall-reaction-{{ entry.post.id }}">
            {% for reaction_type in reaction_types %}
            <li>
              <form action="{{ url_for('add_reaction') }}" method="POST">
                <input type="hidden" name="post_id" value="{{ entry.post.id }}">
                <input type="hidden" name="reaction" value="{{ reaction_type }}">
                <button type="submit" class="dropdown-item">{{ reaction_emojis.get(reaction_type, '👍') }} {{ reaction_type|capitalize }}</button>
              </form>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <hr>
      <h6>Comments ({{ entry.comments|length }})</h6>
      {% if entry.comments %}
      <ul class="list-group list-group-flush mb-3">
        {% for comment in entry.comments[-3:] %}
        <li class="list-group-item px-0">
          <div class="d-flex justify-content-between align-items-start gap-2">
            <div class="d-flex align-items-start gap-2">
              {{ user_avatar(comment.username, comment.profile_picture, size='sm') }}
              <div>
                <strong>{{ user_display(comment.username, comment.profile_picture) }}</strong>
                <p class="mb-0" style="white-space: pre-wrap;">{{ comment.content }}</p>
                <small class="text-muted">{{ comment.created_at|datetimeformat }}</small>
              </div>
            </div>
            {% if session.get('user_id') == comment.user_id or session.get('user_id') == entry.post.user_id %}
            <form action="{{ url_for('delete_comment', comment_id=comment.id) }}" method="POST"
                  onsubmit="return confirm('Are you sure you want to delete this comment?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
            {% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      <form action="{{ url_for('add_comment', post_id=entry.post.id) }}" method="POST" class="mt-2">
        <div class="input-group">
          <input type="text" class="form-control" name="content" placeholder="Write a comment..." required>
          <button type="submit" class="btn btn-outline-primary">Comment</button>
        </div>
      </form>
    </div>
  </div>
  {% else %}
  <div class="card shadow-sm">
    <div class="card-body text-center py-5">
      <h3 class="h5">Your Town Hall is just getting started</h3>
      <p class="text-muted mb-0">There are no posts yet. Start the conversation!</p>
    </div>
  </div>
  {% endfor %}
</div>

<div class="d-flex justify-content-center align-items-center my-4">
  <a href="{{ url_for('town_hall', page=page-1) }}"
     class="btn btn-primary {% if page <= 1 %}btn-light disabled{% endif %}">&laquo; Previous</a>
  <span class="mx-3 text-muted">Page {{ page }}</span>
  <a href="{{ url_for('town_hall', page=page+1) }}"
     class="btn btn-primary {% if posts|length < per_page %}disabled{% endif %}">Next &raquo;</a>
</div>
{% endblock %}
