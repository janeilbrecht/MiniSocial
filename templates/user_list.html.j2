{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display, user_avatar %}

<div class="container mt-5 col-md-8 mx-auto">
  <!-- Heading for the page -->
  <h2 class="text-center border-bottom pb-2 mb-4">
    <span>{{ title }} {{ user_display(user.username, user.profile_picture) }}</span>
  </h2>

  <!-- Card to contain the list of users -->
  <div class="card shadow-sm">
    <div class="card-body">
      {% if users %}
        <!-- List group for a clean, vertical list -->
        <div class="d-flex flex-column gap-2">
          {% for u in users %}
            <div class="d-flex align-items-center gap-2 mb-2">
              {{ user_avatar(u.username, u.profile_picture, size='sm') }}
              {{ user_display(u.username, u.profile_picture) }}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <!-- Message to show if there are no users to list -->
        <p class="text-center text-muted mb-0">No {{ title|lower }} found.</p>
      {% endif %}
    </div>
  </div>
</div>

{% endblock %}