{% extends "base.html.j2" %}
{% block content %}
<div class="container mt-4 mb-5">
  <div class="col-lg-8 mx-auto">
    <div class="card shadow-sm">
      <div class="card-header">
        <h3 class="mb-0">Edit Profile</h3>
      </div>
      <div class="card-body p-4">
        <form action="{{ url_for('edit_profile') }}" method="POST" enctype="multipart/form-data">
          
          <!-- Box Background Color -->
          <div class="mb-4">
            <label for="bg_color" class="form-label fw-bold">Profile Box Background Colour</label>
            <div class="d-flex align-items-center gap-3">
              <input type="color" class="form-control form-control-color" id="bg_color" name="bg_color" value="{{ user.bg_color or '#f2f2f2' }}" title="Choose background colour" style="width: 60px; height: 38px; cursor: pointer;">
              <span class="text-muted small">Choose the background colour for your profile card.</span>
            </div>
          </div>

          <hr class="my-4">

          <!-- Banner Picture -->
          <div class="mb-4">
            <label for="banner_picture" class="form-label fw-bold">Banner Picture</label>
            {% if user.banner_picture %}
              <div class="mb-2">
                <img src="{{ url_for('static', filename='uploads/' + user.banner_picture) }}" alt="Current Banner" class="profile-banner-preview d-block mb-2">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="remove_banner_picture" id="remove_banner_picture" value="1">
                  <label class="form-check-label text-danger small" for="remove_banner_picture">
                    Remove current banner picture
                  </label>
                </div>
              </div>
            {% endif %}
            <input class="form-control" type="file" id="banner_picture" name="banner_picture" accept="image/png, image/jpeg, image/gif, image/webp">
            <div class="form-text">Recommended size: 1200x300. Supported formats: PNG, JPG, JPEG, GIF, WEBP (Max 5MB).</div>
          </div>

          <hr class="my-4">

          <!-- Profile Picture (Avatar) -->
          <div class="mb-4">
            <label for="profile_picture" class="form-label fw-bold">Profile Picture (Avatar)</label>
            {% if user.profile_picture %}
              <div class="mb-2 d-flex align-items-center gap-3">
                <img src="{{ url_for('static', filename='uploads/' + user.profile_picture) }}" alt="Current Profile Picture" class="profile-avatar-preview">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="remove_profile_picture" id="remove_profile_picture" value="1">
                  <label class="form-check-label text-danger small" for="remove_profile_picture">
                    Remove current profile picture
                  </label>
                </div>
              </div>
            {% endif %}
            <input class="form-control" type="file" id="profile_picture" name="profile_picture" accept="image/png, image/jpeg, image/gif, image/webp">
            <div class="form-text">Square ratio recommended (e.g. 250x250). Supported formats: PNG, JPG, JPEG, GIF, WEBP (Max 5MB).</div>
          </div>

          <hr class="my-4">

          <!-- Verified city selector -->
          <div class="mb-3">
            <label for="location" class="form-label fw-bold">Location</label>
            <div class="position-relative">
              <input type="text" class="form-control" id="location" name="location"
                     value="{{ user.location or '' }}" placeholder="Search for a city..."
                     autocomplete="off" aria-autocomplete="list" aria-controls="city-suggestions">
              <input type="hidden" id="city_id" name="city_id" value="{{ user.city_id or '' }}">
              <div id="city-suggestions" class="list-group position-absolute w-100 shadow-sm" role="listbox"
                   style="z-index: 1050; display: none; max-height: 240px; overflow-y: auto;"></div>
            </div>
            <div class="form-text">Start typing and select a city from the suggestions. Leave blank if you don't want to display a location.</div>
            <div id="location-selection-status" class="small mt-1" aria-live="polite"></div>
          </div>

          <!-- Birthdate -->
          <div class="mb-3">
            <label for="birthdate" class="form-label fw-bold">Birthdate</label>
            <input type="date" class="form-control" id="birthdate" name="birthdate" value="{{ user.birthdate or '' }}">
          </div>

          <!-- Bio / Profile Description -->
          <div class="mb-4">
            <label for="profile" class="form-label fw-bold">Bio</label>
            <textarea class="form-control" id="profile" name="profile" rows="4" placeholder="Tell the community about yourself...">{{ user.profile or '' }}</textarea>
          </div>

          <!-- Actions -->
          <div class="d-flex justify-content-between align-items-center pt-2">
            <a href="{{ url_for('user_profile', username=user.username) }}" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  const input = document.getElementById('location');
  const cityIdInput = document.getElementById('city_id');
  const suggestions = document.getElementById('city-suggestions');
  const status = document.getElementById('location-selection-status');
  let activeResults = [];
  let requestNumber = 0;

  function closeSuggestions() {
    suggestions.style.display = 'none';
    suggestions.replaceChildren();
    activeResults = [];
  }

  input.addEventListener('input', async () => {
    cityIdInput.value = '';
    status.textContent = '';
    const query = input.value.trim();
    const thisRequest = ++requestNumber;
    if (query.length < 2) {
      closeSuggestions();
      return;
    }
    try {
      const response = await fetch(`/api/cities?q=${encodeURIComponent(query)}`);
      if (!response.ok || thisRequest !== requestNumber) return;
      activeResults = await response.json();
      suggestions.replaceChildren();
      if (!activeResults.length) {
        const empty = document.createElement('div');
        empty.className = 'list-group-item text-muted small';
        empty.textContent = 'No matching cities found.';
        suggestions.appendChild(empty);
      } else {
        activeResults.forEach((place) => {
          const option = document.createElement('button');
          option.type = 'button';
          option.className = 'list-group-item list-group-item-action';
          option.setAttribute('role', 'option');
          option.textContent = place.label;
          option.addEventListener('click', () => {
            input.value = place.label;
            cityIdInput.value = place.id;
            status.textContent = 'Verified location selected.';
            status.className = 'small mt-1 text-success';
            closeSuggestions();
          });
          suggestions.appendChild(option);
        });
      }
      suggestions.style.display = 'block';
    } catch (error) {
      closeSuggestions();
      status.textContent = 'Could not load city suggestions. Please try again.';
      status.className = 'small mt-1 text-danger';
    }
  });

  document.addEventListener('click', (event) => {
    if (!suggestions.contains(event.target) && event.target !== input) closeSuggestions();
  });

  if (cityIdInput.value) {
    status.textContent = 'Verified location selected.';
    status.className = 'small mt-1 text-success';
  }
})();
</script>
{% endblock %}
