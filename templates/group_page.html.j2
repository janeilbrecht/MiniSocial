{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display, user_avatar %}

<div class="container mt-4 mb-5">

  <!-- Group Information Card (styled like user profile page) -->
  <div class="card col-lg-8 mx-auto profile-card {% if is_dark_color(group.bg_color) %}profile-card-dark{% else %}profile-card-light{% endif %}" style="background-color: {{ group.bg_color or '#f2f2f2' }};">
    <!-- Banner Picture -->
    <div class="profile-banner-container {% if not group.banner_picture %}profile-banner-default{% endif %}">
      {% if group.banner_picture %}
        <img src="{{ url_for('static', filename='uploads/' + group.banner_picture) }}" alt="{{ group.name }} banner" class="profile-banner-img">
      {% endif %}
    </div>

    <div class="card-body position-relative px-4 pb-4 pt-0">
      <!-- Group Icon and Actions -->
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 profile-avatar-container">
        <div>
          <div class="profile-avatar-placeholder" style="background-color: {{ loop_color(group.name) }}; font-size: 2.2rem;">
            g/
          </div>
        </div>
        <div>
          {% if session.get('user_id') %}
            {% if is_member %}
              <div class="d-flex align-items-center gap-2">
                {% if is_admin %}
                  <span class="badge bg-warning text-dark px-3 py-2 fs-6">Admin</span>
                {% endif %}
                <form action="{{ url_for('leave_group', name=group.name) }}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-secondary">Leave Group</button>
                </form>
              </div>
            {% else %}
              <form action="{{ url_for('join_group', name=group.name) }}" method="POST" class="d-inline">
                <button type="submit" class="btn btn-primary">Join Group</button>
              </form>
            {% endif %}
          {% else %}
            <a href="{{ url_for('login') }}" class="btn btn-primary">Login to Join</a>
          {% endif %}
        </div>
      </div>

      <!-- Group Details -->
      <div class="mt-2">
        <h2 class="card-title mb-1 fw-bold">g/{{ group.name }}</h2>
        <div class="text-muted mb-2 d-flex align-items-center gap-2">
          <span>Admin:</span>
          {{ user_avatar(group.admin_username, group.admin_profile_picture, size='sm') }}
          {{ user_display(group.admin_username, group.admin_profile_picture) }}
        </div>

        <p class="card-text text-muted mb-3">
          <strong>Created:</strong> {{ group.created_at|datetimeformat }}
        </p>

        <p class="card-text fs-6">{{ group.description or "No description provided for this group." }}</p>

        <div class="mt-4 d-flex align-items-center flex-wrap gap-3">
          <div>
            {% if not group.hide_members or is_admin %}
              <a href="{{ url_for('group_members_list', name=group.name) }}" class="text-decoration-none profile-stats-link">
                <strong>{{ member_count }}</strong> Members
              </a>
              {% if group.hide_members and is_admin %}
                <span class="badge bg-secondary ms-1" title="Member list is hidden from non-admins">Hidden</span>
              {% endif %}
            {% else %}
              <span class="text-muted" title="Member list is hidden by group admin">
                <strong>{{ member_count }}</strong> Members <span class="badge bg-secondary ms-1">Hidden</span>
              </span>
            {% endif %}
          </div>
          <div>
            <span>
              <strong>{{ post_count }}</strong> Posts
            </span>
          </div>
          {% if is_admin %}
            <div class="ms-sm-auto d-flex align-items-center gap-2">
              <a href="{{ url_for('edit_group', name=group.name) }}" class="btn btn-sm btn-light text-dark border">Edit Group</a>
              <form action="{{ url_for('toggle_group_members_visibility', name=group.name) }}" method="POST" class="d-inline">
                {% if group.hide_members %}
                  <button type="submit" class="btn btn-sm btn-light text-dark border" title="Click to make member list visible to everyone">
                    Show Members
                  </button>
                {% else %}
                  <button type="submit" class="btn btn-sm btn-light text-dark border" title="Click to hide member list from non-admins">
                    Hide Members
                  </button>
                {% endif %}
              </form>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- Create Post in Group Card -->
  {% if session.get('user_id') and is_member %}
  <div class="col-lg-8 mx-auto mt-4 mb-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title mb-3">Post to g/{{ group.name }}</h5>
        <form action="{{ url_for('add_group_post', name=group.name) }}" method="POST">
          <div class="mb-3">
            <textarea class="form-control" name="content" rows="3" placeholder="Share something with g/{{ group.name }}..." required></textarea>
          </div>
          <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">Post to Group</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- Group Posts Header -->
  <h3 class="text-center border-bottom pb-2 my-5 col-lg-8 mx-auto">
    <span>Posts in g/{{ group.name }}</span>
  </h3>

  <!-- Group Posts List -->
  <div class="col-lg-8 mx-auto">
    {% for entry in posts %}
    <div class="card mb-4" id="post-{{ entry.post.id }}">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            {{ user_avatar(entry.post.username, entry.post.profile_picture, size='md') }}
            <div>
              <h4 class="card-title mb-0 fs-5">
                {{ user_display(entry.post.username, entry.post.profile_picture) }}
                {% if entry.followed_poster %}
                  <span class="text-success p-1" data-toggle="tooltip" data-placement="top" title="You are following this user"> ✓ </span>
                {% endif %}
              </h4>
              <small class="text-muted">{{ entry.post.created_at|datetimeformat }}</small>
            </div>
          </div>

          {% if session.get('user_id') == entry.post.user_id or is_admin or session.get('username') == 'admin' %}
          <div class="d-flex align-items-center">
            <form action="{{ url_for('delete_post', post_id=entry.post.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?');">
              <button type="submit" class="btn btn-danger btn-sm" title="Delete Post">
                delete
              </button>
            </form>
          </div>
          {% endif %}
        </div>

        <p class="mt-3">{{ entry.post.content }}</p>

        <!-- Reactions Display and Add Reaction Button -->
        <div class="d-flex align-items-center mt-2 mb-2">
          <div class="reactions-display me-2">
            {% if entry.reactions %}
              {% for react in entry.reactions %}
                {% if react.reaction_type == entry.user_reaction %}
                  <form action="{{ url_for('unreact') }}" method="post" class="d-inline">
                    <input type="hidden" name="post_id" value="{{ entry.post.id }}">
                    <button type="submit" class="btn btn-light text-dark me-1" title="{{ react.reaction_type|capitalize }}">
                      {{ reaction_emojis.get(react.reaction_type, '👍') }} {{ react.count }}
                    </button>
                  </form>
                {% else %}
                  <span class="text-dark me-1" title="{{ react.reaction_type|capitalize }}">
                    {{ reaction_emojis.get(react.reaction_type, '👍') }} {{ react.count }}
                  </span>
                {% endif %}
              {% endfor %}
            {% else %}
              <span class="text-muted">No reactions yet</span>
            {% endif %}
          </div>

          <!-- Add Reaction Dropdown Button -->
          {% if session.get('user_id') %}
          <div class="dropdown">
            <button class="btn btn-sm btn-light text-dark rounded-circle m-0" type="button" id="dropdownMenuButton-{{ entry.post.id }}" data-bs-toggle="dropdown" aria-expanded="false" title="Add Reaction">
              +
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-{{ entry.post.id }}">
              {% for reaction_type in reaction_types %}
              <li>
                <form action="{{ url_for('add_reaction') }}" method="POST" class="d-inline">
                  <input type="hidden" name="post_id" value="{{ entry.post.id }}">
                  <input type="hidden" name="reaction" value="{{ reaction_type }}">
                  <button type="submit" class="dropdown-item">
                    {{ reaction_emojis.get(reaction_type, '👍') }} {{ reaction_type|capitalize }}
                  </button>
                </form>
              </li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
        </div>

        <!-- Comments Section -->
        {% if entry.comments %}
        <hr>
        <h6 class="mb-0">Comments ({{ entry.comments | count }})</h6>
        <ul class="list-group list-group-flush shadow-none border-0">
          {% for comment in entry.comments[-2:] %}
          <li class="card shadow-none p-2 mt-2">
            <div class="d-flex justify-content-between align-items-start">
              <div class="d-flex align-items-start gap-2">
                {{ user_avatar(comment.username, comment.profile_picture, size='sm') }}
                <div>
                  <strong>{{ user_display(comment.username, comment.profile_picture) }}</strong>
                  <p class="mb-0">{{ comment.content }}</p>
                </div>
              </div>
              
              {% if session.get('user_id') == comment.user_id or session.get('user_id') == entry.post.user_id or is_admin or session.get('username') == 'admin' %}
              <form action="{{ url_for('delete_comment', comment_id=comment.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                <button type="submit" class="btn btn-danger btn-sm">delete</button>
              </form>
              {% endif %}
            </div>
          </li>
          {% endfor %}
        </ul>
        {% endif %}

        {% if entry.comments | length > 2 %}
        <div class="text-center mt-2">
          <a href="{{ url_for('post_detail', post_id=entry.post.id) }}" class="btn btn-link btn-sm">View all comments</a>
        </div>
        {% endif %}

        {% if session.get('user_id') and is_member %}
        <form action="{{ url_for('add_comment', post_id=entry.post.id) }}" method="POST" class="mt-3">
          <div class="input-group">
            <input type="text" name="content" class="form-control" placeholder="Write a comment..." required>
            <button type="submit" class="btn btn-primary">Comment</button>
          </div>
        </form>
        {% else %}
        <p class="text-muted small mt-3 mb-0">
          {% if session.get('user_id') %}
            Join g/{{ group.name }} to comment on its posts.
          {% else %}
            <a href="{{ url_for('login') }}">Log in</a> and join g/{{ group.name }} to comment on its posts.
          {% endif %}
        </p>
        {% endif %}
      </div>
    </div>
    {% else %}
    <div class="card shadow-none bg-light p-4 text-center">
      <p class="text-muted mb-0">No posts in this group yet. Be the first to start a conversation!</p>
    </div>
    {% endfor %}
  </div>

</div>
{% endblock %}
