{% macro user_avatar(username, profile_picture=None, size='md') %}
  <a href="/u/{{ username }}" class="text-decoration-none d-inline-block">
    {% if profile_picture %}
      <img src="{{ url_for('static', filename='uploads/' + profile_picture) }}" alt="{{ username }}" class="post-avatar post-avatar-{{ size }}">
    {% else %}
      <div class="post-avatar-placeholder post-avatar-{{ size }}" style="background-color: {{ loop_color(username) }};">
        {{ username[0]|upper }}
      </div>
    {% endif %}
  </a>
{% endmacro %}

{% macro user_display(user_id, profile_picture=None) %}
  {% set color = loop_color(user_id) %}
  <a href="/u/{{ user_id }}" class="text-decoration-none d-inline-flex align-items-center" style="color: {{ color }};">
    <span>@{{ user_id }}</span>
  </a>
{% endmacro %}
