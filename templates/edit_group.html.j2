{% extends "base.html.j2" %}
{% block content %}
<div class="container mt-4 mb-5">
  <div class="col-lg-8 mx-auto">
    <div class="card shadow-sm">
      <div class="card-header">
        <h3 class="mb-0">Edit g/{{ group.name }}</h3>
      </div>
      <div class="card-body p-4">
        <form action="{{ url_for('edit_group', name=group.name) }}" method="POST" enctype="multipart/form-data">

          <!-- Box Background Color -->
          <div class="mb-4">
            <label for="bg_color" class="form-label fw-bold">Group Box Background Colour</label>
            <div class="d-flex align-items-center gap-3">
              <input type="color" class="form-control form-control-color" id="bg_color" name="bg_color" value="{{ group.bg_color or '#f2f2f2' }}" title="Choose background colour" style="width: 60px; height: 38px; cursor: pointer;">
              <span class="text-muted small">Choose the background colour for the group card.</span>
            </div>
          </div>

          <hr class="my-4">

          <!-- Banner Picture -->
          <div class="mb-4">
            <label for="banner_picture" class="form-label fw-bold">Banner Picture</label>
            {% if group.banner_picture %}
              <div class="mb-2">
                <img src="{{ url_for('static', filename='uploads/' + group.banner_picture) }}" alt="Current Banner" class="profile-banner-preview d-block mb-2">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="remove_banner_picture" id="remove_banner_picture" value="1">
                  <label class="form-check-label text-danger small" for="remove_banner_picture">
                    Remove current banner picture
                  </label>
                </div>
              </div>
            {% endif %}
            <input class="form-control" type="file" id="banner_picture" name="banner_picture" accept="image/png, image/jpeg, image/gif, image/webp">
            <div class="form-text">Recommended size: 1200x300. Supported formats: PNG, JPG, JPEG, GIF, WEBP (Max 5MB).</div>
          </div>

          <hr class="my-4">

          <!-- Description -->
          <div class="mb-4">
            <label for="description" class="form-label fw-bold">Description</label>
            <textarea class="form-control" id="description" name="description" rows="4" placeholder="What is this group about?">{{ group.description or '' }}</textarea>
          </div>

          <!-- Member list visibility -->
          <div class="form-check form-switch mb-4">
            <input class="form-check-input" type="checkbox" role="switch" id="hide_members" name="hide_members" value="1" {% if group.hide_members %}checked{% endif %}>
            <label class="form-check-label" for="hide_members">Hide member list from non-admins</label>
          </div>

          <!-- Actions -->
          <div class="d-flex justify-content-between align-items-center pt-2">
            <a href="{{ url_for('group_page', name=group.name) }}" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
